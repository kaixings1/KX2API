{
  "name": "kx2code",
  "version": "1.0.0",
  "private": true,
  "description": "KX2Code - AI 编程智能体桌面端，集成代理服务与代码引擎",
  "author": "kaixings <30445355@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaixings1/KX2API.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:portable": "npm run build && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps",
    "test": "node tests/agent/run.mjs",
    "test:management": "node tests/management/run.mjs",
    "test:all": "npm run test && npm run test:management && npm run test:extras && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:extras": "node tests/run-all.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "check:integration": "node scripts/check-integration.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "fix:eol": "node scripts/normalize-eol.mjs"
  },
  "dependencies": {
    "@koa/router": "^15.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ali-oss": "^6.23.0",
    "axios": "^1.7.7",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "eventsource-parser": "^3.0.6",
    "fastest-levenshtein": "^1.0.16",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-sha3": "^0.9.3",
    "jsonrepair": "^3.15.0",
    "koa": "^2.15.3",
    "koa-bodyparser": "^4.4.1",
    "lucide-react": "^0.454.0",
    "mime-types": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.3.0",
    "recharts": "^3.7.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "zstd-codec": "^0.1.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-router": "^7.4.8",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.kx2code.desktop",
    "productName": "KX2Code",
    "copyright": "Copyright 2026 kaixings",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/electron-updater/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KX2Code-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "electron@33.0.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "utf-8-validate@6.0.6": true
  }
}
